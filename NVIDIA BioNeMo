import torch
from bionemo.model.protein.esm2nv.model import ESM2nvModel
from bionemo.core import setup_trainer

# 1. Load the model configuration (typically from a YAML file)
# In practice, you use @hydra_runner to inject this config
cfg = {
    "model": {
        "encoder": {"num_layers": 33, "hidden_size": 1280},
        "checkpoint": "esm2_650m_unity.nemo" # Path to model weights
    }
}

# 2. Initialize the model and trainer
trainer = setup_trainer(cfg)
model = ESM2nvModel.restore_from(cfg.model.checkpoint, trainer=trainer)
model.eval()

# 3. Process a protein sequence (Amino Acid sequence)
# Example: Insulin human sequence
sequence = "GIVEQCCTSICSLYQLENYCN"
tokens = model.tokenizer.encode(sequence)
input_ids = torch.tensor([tokens]).to("cuda")

# 4. Generate Embeddings (Hidden States)
with torch.no_state():
    hidden_states = model(input_ids)
    # Mean pooling to get a single vector for the whole protein
    protein_embedding = hidden_states.mean(dim=1)

print(f"Generated embedding shape: {protein_embedding.shape}")
