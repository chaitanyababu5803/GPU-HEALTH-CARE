🧠 Step 3: The MONAI Pipeline (Dictionary Style)
This is the core "Basic Project" code. We use Dictionary Transforms because they ensure that if we rotate the image, we rotate the mask exactly the same way.
python
import torch
from monai.transforms import (
    Compose, LoadImaged, EnsureChannelFirstd, Spacingd,
    Orientationd, ScaleIntensityRanged, Resized, ToTensord
)
from monai.networks.nets import UNet
from monai.losses import DiceLoss

# 1. Define the Medical-Specific Pipeline
data_pipeline = Compose([
    LoadImaged(keys=["image", "label"]),
    EnsureChannelFirstd(keys=["image", "label"]),
    # Ensure all scans are in 'RAS' orientation (Right-Anterior-Superior)
    Orientationd(keys=["image", "label"], axcodes="RAS"),
    # Target Spleen CT intensity: ignore air (-1000) and bone (1000+)
    ScaleIntensityRanged(
        keys=["image"], a_min=-57, a_max=164, 
        b_min=0.0, b_max=1.0, clip=True
    ),
    Resized(keys=["image", "label"], spatial_size=(128, 128, 128)),
    ToTensord(keys=["image", "label"])
])

# 2. Setup the GPU-Optimized 3D Model
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = UNet(
    spatial_dims=3,
    in_channels=1,
    out_channels=2, # Class 0: Background, Class 1: Spleen
    channels=(16, 32, 64, 128, 256),
    strides=(2, 2, 2, 2),
    num_res_units=2,
).to(device)

# 3. Loss Function for Imbalanced Medical Data
# DiceLoss is standard because organs are tiny compared to the whole body
loss_function = DiceLoss(to_onehot_y=2, softmax=True)
optimizer = torch.optim.Adam(model.parameters(), 1e-4)
